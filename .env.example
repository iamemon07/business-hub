# ─── Database ─────────────────────────────────────────────────
# One database holds every business (data is separated by business id).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/businesshub?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────
# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ─── Platform ─────────────────────────────────────────────────
# Root domain. The landing page + /console live here; each business gets <slug>.<PLATFORM_DOMAIN>.
# Local: localhost:3000  (open nivorea.localhost:3000 for a business)   Production: e.g. bizhub.com.bd
PLATFORM_DOMAIN=localhost:3000
PLATFORM_NAME=Business Hub

# First super admin (created by `npm run seed`)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ─── Email (invoices, order alerts, lead alerts) ───────────────
# One mailbox sends for every business, using the business's name as the sender name.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Business Hub <your@gmail.com>"

# ─── Image uploads (optional) — Cloudinary ─────────────────────
# Each business's uploads go to the folder hub/<slug>.
CLOUDINARY_URL=
